PORT=8080
DB_PATH=./data/wifi.db
# Segredo para HMAC do CPF e da cadeia de hash. TROQUE e guarde fora do repositório.
APP_SECRET=troque-este-segredo-longo-e-aleatorio
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
# Token usado pelo gateway/proxy/DNS para enviar eventos (Authorization: Bearer ...)
INGEST_TOKEN=troque-este-token

# Identificação do controlador (exibida na política de privacidade)
ORG_NAME=Minha Empresa Ltda
ORG_CNPJ=00.000.000/0001-00
DPO_NAME=Encarregado de Dados
DPO_EMAIL=privacidade@example.com.br
POLICY_VERSION=2026-10-13

# Marco Civil art. 13: guarda de registros de conexão >= 365 dias (valor menor é ignorado)
CONN_RETENTION_DAYS=365
# Registro de navegação (domínios). off = não coleta (padrão). domain = só nome de domínio.
# ATENÇÃO: veja docs/COMPLIANCE.md (art. 14 do Marco Civil) antes de ativar.
NAV_LOGGING=off
NAV_RETENTION_DAYS=180
# Porta UDP para receber syslog (dnsmasq/squid). 0 = desativado
SYSLOG_UDP_PORT=0
# Integração com o equipamento: log | webhook
GATEWAY_MODE=log
GATEWAY_WEBHOOK_URL=
OTP_TTL_MINUTES=10
TRUST_GATEWAY_PARAMS=0
